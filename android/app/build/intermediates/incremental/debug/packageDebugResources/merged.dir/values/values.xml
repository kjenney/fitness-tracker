<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent">#66BB6A</color>
    <color name="bad">#C62828</color>
    <color name="cardBg">#FFFFFF</color>
    <color name="good">#2E7D32</color>
    <color name="primary">#2E7D32</color>
    <color name="primaryDark">#1B5E20</color>
    <color name="textMuted">#616161</color>
